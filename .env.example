# Shared
DATABASE_URL=postgresql://maia:maia@localhost:5432/maia

# Discord application (Bot + OAuth use the same app)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=

# Bot token (required on dashboard for Discord REST moderation + on the bot worker)
# Same value as DISCORD_TOKEN above — dashboard uses it server-side only.

# Optional: register slash commands to one guild during development (instant updates)
DISCORD_DEV_GUILD_ID=

# Optional: separate pepper for API key hashing (defaults to AUTH_SECRET)
# MAIA_API_KEY_PEPPER=

# Dashboard auth (Auth.js / NextAuth v5)
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Public values exposed to the browser
NEXT_PUBLIC_DISCORD_CLIENT_ID=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Legacy alias supported by Auth.js if AUTH_URL is unset
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=same-as-AUTH_SECRET
